#!/bin/bash
# Picks which hardware SSH key (k1 primary / k2 backup) matches the YubiKey
# that is plugged in, so ssh asks for ONE passphrase and never tries the
# absent key first.
#
#   yk-select k1|k2|any     exit 0 if that slot should be used (for ssh_config `Match exec`)
#   yk-select --slot        print the chosen slot: k1, k2 or any
#   yk-select --describe    coloured one-line summary for humans
#   yk-select --learn SLOT  record the currently plugged-in key as SLOT
#
# Serial -> slot map lives OUTSIDE the repo: ~/.ssh/yubikey-map ("<serial> k1|k2").
# Unknown key / no ykman -> "any": ssh tries both, and connect.sh learns the mapping.
MAP=~/.ssh/yubikey-map
CACHE=~/.ssh/cm/yk-present
TTL=10

present() {
  if [ -f "$CACHE" ] && [ $(( $(date +%s) - $(stat -f %m "$CACHE") )) -lt $TTL ]; then
    cat "$CACHE"; return
  fi
  local s=""
  command -v ykman >/dev/null 2>&1 && s=$(ykman list --serials 2>/dev/null)
  mkdir -p "${CACHE%/*}" 2>/dev/null
  printf '%s\n' "$s" > "$CACHE" 2>/dev/null
  printf '%s\n' "$s"
}

slot_of() { [ -f "$MAP" ] && awk -v s="$1" '$1==s{print $2; exit}' "$MAP"; }

choose() {
  local ser have1= have2=
  for ser in $(present); do
    case "$(slot_of "$ser")" in k1) have1=1 ;; k2) have2=1 ;; esac
  done
  if [ -n "$have1" ]; then echo k1; elif [ -n "$have2" ]; then echo k2; else echo any; fi
}

case "$1" in
  k1|k2|any) [ "$(choose)" = "$1" ] ;;
  --slot) choose ;;
  --learn)
    [[ "$2" =~ ^k[12]$ ]] || { echo "usage: yk-select --learn k1|k2" >&2; exit 2; }
    rm -f "$CACHE"; sers=$(present)
    [ "$(printf '%s\n' $sers | grep -c .)" -eq 1 ] || { echo "plug in exactly one YubiKey to learn" >&2; exit 1; }
    touch "$MAP"; chmod 600 "$MAP"
    grep -v "^$sers " "$MAP" > "$MAP.tmp"; echo "$sers $2" >> "$MAP.tmp"; mv "$MAP.tmp" "$MAP"
    ;;
  --describe)
    G=$'\033[1;32m' Y=$'\033[1;33m' R=$'\033[1;31m' C=$'\033[1;36m' D=$'\033[2m' N=$'\033[0m'
    rm -f "$CACHE"; sers=$(present)
    if ! command -v ykman >/dev/null 2>&1; then
      echo "${Y}! ykman not installed - can't detect the key, ssh will try k1 then k2${N}"; exit 0
    fi
    if [ -z "$sers" ]; then echo "${R}✘ No YubiKey detected - plug one in${N}"; exit 1; fi
    for ser in $sers; do
      case "$(slot_of "$ser")" in
        k1) echo "${G}✔ Primary YubiKey (k1)${N} ${D}serial $ser${N}" ;;
        k2) echo "${G}✔ Backup YubiKey (k2)${N} ${D}serial $ser${N}" ;;
        *)  echo "${Y}? Unknown YubiKey${N} ${D}serial $ser - ssh will try both and remember which works${N}" ;;
      esac
    done
    c=$(choose); [ "$c" != any ] && echo "${C}→ using ~/.ssh/id_ed25519_sk_servers_$c${N}"
    ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
