macos-titlebar-style = hidden
scrollback-limit = 50000000

# Matches the Catppuccin Mocha theme used in tmux.
theme = Catppuccin Mocha

# Option key sends Alt (ESC prefix) so tmux sees M-h/j/k/l resize bindings.
macos-option-as-alt = true



mouse-hide-while-typing = true
confirm-close-surface = true

# Ensure ctrl+s is never consumed by ghostty and always reaches the shell/tmux.
keybind = ctrl+s=unbind
font-family = "JetBrainsMono Nerd Font"


keybind = global:cmd+backquote=toggle_quick_terminal

# Generated by Spectre v0.3.0 - Ghostty Config Generator
# Spectre schema target: Ghostty 1.3.1
# https://github.com/imrajyavardhan12/spectre-ghostty-config
# Theme: Catppuccin Mocha

# Colors
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #f5e0dc
selection-foreground = #1e1e2e
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
