# Shared git config (aliases only). Linked to ~/.config/git/config by symlinks.sh.
# Identity, credentials, lfs etc. stay machine-local in ~/.gitconfig, which
# git reads AFTER this file, so local values win.
[alias]
	co = checkout
	b = branch
	st = status
	cm = commit -m
	sl = stash list
	rc = rebase --continue
	ca = commit --amend
	ra = rebase --abort
	cc = cherry-pick --continue
	squash = !git add -u && git cm "CommitToSquash" && git rebase -i head~2
	npushed = log @{u}..
	whenadded = log --diff-filter=A --
	mrpush = push -f origin
	p = push -u origin
	fp = push --force-with-lease origin
	reuse = commit --reuse-message=ORIG_HEAD
	ucm = reset --soft HEAD~1
	tracking = remote show origin
	av = !git add -u && git gui

[status]
	submoduleSummary = false
