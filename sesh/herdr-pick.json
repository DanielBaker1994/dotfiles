{
  "meta": {
    "name": "herdr-pick",
    "version": 1,
    "readme": "Everything the prefix+w picker says, runs and draws. No strings or CLI calls live in the Rust code; they are all here. Palette defaults to the kitchen-sink [theme] section in commands.toml (via style.palette_source), falling back to the values in style.palette."
  },

  "bins": {
    "herdr": "herdr",
    "herdr_env": "HERDR_BIN_PATH",
    "herdr_fallbacks": ["$HOME/.local/bin/herdr"],
    "sesh": "sesh",
    "zoxide": "zoxide",
    "fd": "fd",
    "ls": "ls",
    "terminal_browser": "$HOME/.local/bin/terminal-browser"
  },

  "commands": {
    "snapshot": ["api", "snapshot"],
    "workspace_list": ["workspace", "list"],
    "tab_list": ["tab", "list"],
    "pane_list": ["pane", "list"],
    "workspace_focus": ["workspace", "focus", "{id}"],
    "workspace_create": ["workspace", "create", "--cwd", "{path}", "--label", "{label}", "--focus"],
    "workspace_close": ["workspace", "close", "{id}"],
    "tab_focus": ["tab", "focus", "{id}"],
    "tab_close": ["tab", "close", "{id}"],
    "agent_focus": ["agent", "focus", "{id}"],
    "pane_get": ["pane", "get", "{id}"],
    "pane_read": ["pane", "read", "{id}", "--source", "visible", "--format", "ansi"],
    "pane_run": ["pane", "run", "{id}", "{cmd}"],
    "pane_move_tab": ["pane", "move", "{pane}", "--tab", "{tab}", "--split", "right", "--no-focus"],
    "pane_move_new_tab": ["pane", "move", "{pane}", "--new-tab", "--workspace", "{ws}", "--no-focus"],
    "sesh_list_config": ["list", "-c", "-j"],
    "sesh_preview": ["preview", "{target}"],
    "zoxide_query": ["query", "-ls"],
    "zoxide_remove": ["remove", "{path}"],
    "zoxide_add": ["add", "{path}"],
    "fd_dirs": ["-H", "-d", "2", "-t", "d", "-E", ".Trash", "-E", ".git", "-E", "node_modules", ".", "{dir}"],
    "ls_dir": ["-la", "{path}"],
    "aerospace_windows": ["list-windows", "--monitor", "all", "--app-bundle-id", "{bundle}", "--json"],
    "aerospace_focus": ["focus", "--window-id", "{id}"],
    "ks_launch": ["$HOME/.config/kitchen-sink/bin/kitchen_sink.sh", "window"],
    "ghostty_open": ["/usr/bin/open", "-b", "{bundle}"]
  },

  "paths": {
    "sesh_toml": "$HOME/.dotfiles/sesh/sesh.toml",
    "mru_file": "$HOME/.local/state/herdr/plugins/local.last/mru",
    "scratch_script": "$HOME/.dotfiles/sesh/create_scratch.sh",
    "log_dir": "$HOME/.cache/herdr-pick",
    "herdr_socket": "$HOME/.config/herdr/herdr.sock",
    "default_config": "$HOME/.dotfiles/sesh/herdr-pick.json"
  },

  "behavior": {
    "list_timeout_ms": 15000,
    "herdr_timeout_ms": 15000,
    "preview_timeout_ms": 5000,
    "preview_debounce_ms": 15,
    "preview_cache_ms": 3000,
    "preview_prefetch": 1,
    "preview_prefetch_delay_ms": 120,
    "status_ms": 2500,
    "flash_ms": 900,
    "anim_ms": 80,
    "double_click_ms": 400,
    "drag_threshold": 2,
    "wheel_preview_lines": 3,
    "wheel_list_lines": 2,
    "kb_page_lines": 10,
    "narrow_width": 110,
    "list_width_ratio": 55,
    "poll_idle_ms": 200,
    "poll_active_ms": 15,
    "connect_wait_ms": 200,
    "min_score": 1,
    "max_dirs": 40,
    "search_pad": 1000
  },

  "connect": {
    "first_pane": "{id}:p1",
    "browser_label": "Browser{label}",
    "browser_run": "{terminal_browser} open '{url}'"
  },

  "ui": {
    "border_label": " herdr sessions · ? help ",
    "preview_label_fmt": " {text} ",
    "help_label": " help ",
    "prompt_sep": " › ",
    "prompts": { "ws": "spaces", "all": "all", "agents": "agents", "dirs": "dirs" },
    "sorts": ["recent", "name", "status"],
    "table_head": {
      "name": "NAME", "name_w": 22,
      "tabs": "TABS", "tabs_w": 4,
      "agents": "AGENTS", "agents_w": 20,
      "last": "LAST", "sort_mark": "▾"
    },
    "hints": [
      { "key": "^s", "label": "spaces", "active_modes": ["ws"] },
      { "key": "^a", "label": "all", "active_modes": ["all"] },
      { "key": "^t", "label": "agents", "active_modes": ["agents"] },
      { "key": "^x", "label": "dirs", "active_modes": ["dirs"] },
      { "key": "^m", "label": "expand", "alt": "collapse", "modes": ["ws", "all"] },
      { "key": "^o", "label": "new" },
      { "key": "^r", "label": "sort: {sort}", "modes": ["ws", "all"] },
      { "key": "?", "label": "more", "last": true }
    ],
    "hint_sep": "  ",
    "info_fmt": "{shown}/{total}",
    "loading": "⋯ ",
    "splits_fmt": "{n} splits",
    "age": { "now": "now", "min": "{n}m", "hour": "{n}h", "day": "{n}d" },
    "box": { "tl": "╭", "tr": "╮", "bl": "╰", "br": "╯", "h": "─", "v": "│" },
    "edge_pulse": ["┆", "│"],
    "preview_grid": { "enabled": true, "max": 4, "min_tabs": 2 }
  },

  "icons": {
    "status": { "working": "●", "blocked": "▲", "done": "✓", "idle": "○", "unknown": " " },
    "tree_mid": "├",
    "tree_last": "└",
    "pipe": "│",
    "grip": "⠿",
    "cfg": "\ue615",
    "dir": "\uf114",
    "sep": "›",
    "active_dot": "•",
    "landing_add": "[+]",
    "group_closed": "▸",
    "group_open": "▾",
    "link_kinds": { "view": "\uf2d0", "note": "\uf15c", "folder": "\uf114", "workspace": "\uf120" }
  },

  "rows": {
    "ws": "{icon} {label:22} {tabs:4} {agents:20} {last}",
    "tab": "  {branch} {icon} {number} {text}{splits}{active}",
    "pane": "  {pipe}   {branch} {grip} {icon} {text}  {id}",
    "agent": "{icon} {ws} {sep} {number}  {agent}  {title}",
    "cfg": "{icon} {name}  {saved}",
    "dir": "{icon} {path}  {tag}",
    "group": "{arrow} {label} · {tail}",
    "link": "    {icon} {title}  {subtitle}"
  },

  "texts": {
    "herdr_missing": "herdr: binary not found (checked {env}, PATH, {fallback})",
    "herdr_no_server": "herdr: no server running at {socket}",
    "herdr_start": "herdr: start it first — `herdr` to attach, or `herdr server` headless.",
    "needs_terminal": "herdr-pick: needs a terminal",
    "usage": "usage: herdr-pick [list [MODE|--json] | state | preview LINE | label LINE | kill LINE | go LINE|PATH | go-id WORKSPACE_ID | browser | help]",
    "config_missing": "herdr-pick: config not found (looked at {paths})",
    "config_bad": "herdr-pick: bad config {path}: {err}",
    "drag_status": "drag a split or tab onto a workspace or tab  {key}",
    "drag_status_key": "· ^g moves with keys",
    "drop_hint": "drop on a workspace (new tab) or a tab (split)",
    "new_tab_in": "new tab in {name}",
    "splits_in_here": "splits in here",
    "moving_row": "⇢ moving",
    "moving_label": "moving ⠿",
    "moving_hint": "↑/↓ choose a workspace or tab · enter drop · esc cancel",
    "chip": "⠿ {label}",
    "chip_bad": "✗ {label}",
    "new_tab": "▶ new tab",
    "split": "▶ split",
    "dest_ws": "{name} (new tab)",
    "dest_tab": "{name} (split)",
    "tab_name": "{ws} › tab {n}",
    "tab_short": "tab {n}",
    "tab_what": "{name} ({n} splits)",
    "grid_label": " {name} · {n} tabs ",
    "grid_label_more": " {name} · {n} tabs ({shown} shown) ",
    "moved": "{ok} moved {what} {arrow} {dest}{undo}",
    "arrow": "→",
    "undo_hint": "  ^z undo",
    "dry_move": "dry run: {cmd}",
    "dry_move_tab": "dry run: move tab {id} ({n} panes)",
    "move_failed": "{err} couldn't move {what}: {msg}",
    "nothing_undo": "nothing to undo",
    "cant_undo": "✗ can't undo: split is gone",
    "sorted": "sorted by {sort}",
    "move_help": "^g moves a split or tab: expand (^m), select a ⠿ or tab row",
    "no_agents": "no agents running",
    "saved": "saved",
    "recent": "recent",
    "no_preview": "(no preview)",
    "browser_prompt": "Website URL: ",
    "scratch_prompt": "Scratch name or path: ",
    "shell": "shell",
    "here": "here",
    "none": "-",
    "group_label": "kitchen-sink",
    "group_count": "{n} places",
    "group_loading": "…",
    "group_offline": "not running",
    "group_unavailable": "unavailable",
    "group_preview": "{title}\n{subtitle}",
    "group_header_preview": "kitchen-sink\n\nenter switches to it (its last view)\n→ / l lists its places, ← / h hides them,\n^k jumps here, typing searches them too",
    "group_offline_preview": "kitchen-sink is not running — enter starts it",
    "link_label": " kitchen-sink · {kind} ",
    "link_tab": "1 tab",
    "link_tabs": "{n} tabs",
    "link_subtitle": "{tabs} · {status}",
    "link_herdr_offline": "herdr: no server running",
    "link_failed": "✗ kitchen-sink: {err}"
  },

  "keys": {
    "keymap": {
      "escape": "quit",
      "ctrl+c": "quit",
      "ctrl+q": "quit",
      "enter": "choose",
      "tab": "down",
      "ctrl+n": "down",
      "down": "down",
      "shift+tab": "up",
      "ctrl+p": "up",
      "up": "up",
      "pagedown": "page-down",
      "pageup": "page-up",
      "ctrl+m": "expand",
      "ctrl+e": "expand",
      "ctrl+a": "mode:all",
      "ctrl+t": "mode:agents",
      "ctrl+x": "mode:dirs",
      "ctrl+s": "mode:ws",
      "ctrl+r": "sort",
      "ctrl+o": "scratch",
      "ctrl+b": "browser",
      "ctrl+d": "kill",
      "ctrl+u": "clear-query",
      "ctrl+w": "delete-word",
      "backspace": "backspace",
      "?": "help",
      "ctrl+z": "undo",
      "ctrl+g": "start-move",
      "ctrl+k": "links-jump",
      "right": "group-open",
      "left": "group-close"
    },
    "move_keymap": {
      "escape": "cancel",
      "ctrl+c": "cancel",
      "enter": "drop",
      "down": "next",
      "tab": "next",
      "ctrl+n": "next",
      "j": "next",
      "up": "prev",
      "shift+tab": "prev",
      "ctrl+p": "prev",
      "k": "prev"
    },
    "group_keymap": {
      "ctrl+e": "group-toggle",
      "ctrl+m": "group-toggle",
      "right": "group-open",
      "l": "group-open",
      "left": "group-close",
      "h": "group-close"
    },
    "link_keymap": {
      "left": "group-close"
    }
  },

  "links": {
    "readme": "The link bank (kitchen-sink PLAN-link-bank.md): kitchen-sink's places as a collapsed group pinned on top of the list (the cursor starts on it when start_on_group: enter = switch to kitchen-sink), and herdr's workspaces for kitchen-sink's Ctrl+B W (list --json / go-id). One Ghostty window is assumed; with several, go-id raises the first whose title contains a ghostty_title_match entry, else the first one AeroSpace lists.",
    "ks_socket": "$TMPDIR/ws-notes.sock",
    "ks_list": "links",
    "ks_go": "do:go:{id}",
    "ks_cache": "$HOME/.cache/herdr-pick/ks-links.json",
    "timeout_ms": 300,
    "go_timeout_ms": 3000,
    "aerospace": ["aerospace", "/opt/homebrew/bin/aerospace", "/usr/local/bin/aerospace"],
    "aerospace_timeout_ms": 2000,
    "ghostty_bundle": "com.mitchellh.ghostty",
    "ghostty_title_match": [],
    "modes": ["ws", "all"],
    "start_on_group": true,
    "status_map": { "working": "working", "blocked": "waiting", "done": "idle", "idle": "idle", "unknown": "unknown" }
  },

  "style": {
    "palette": {
      "base": "#192330",
      "header": "#0F141C",
      "crust": "#0F141C",
      "mantle": "#141B26",
      "surface0": "#29323E",
      "surface1": "#363E49",
      "highlight": "#2B3B51",
      "text": "#CDCECF",
      "dim": "#AEAFB0",
      "accent": "#719CD6",
      "accent2": "#9D79D6",
      "success": "#81B29A",
      "warning": "#DBC074",
      "danger": "#C94F6D",
      "info": "#63CDCF",
      "outline": "#41597C"
    },
    "palette_source": {
      "file": "$HOME/.config/kitchen-sink/commands.toml",
      "section": "theme",
      "map": {
        "background": "base",
        "header": "header",
        "highlight": "highlight",
        "text": "text",
        "dim": "dim",
        "accent": "accent",
        "accent2": "accent2",
        "success": "success",
        "warning": "warning",
        "danger": "danger",
        "info": "info"
      },
      "derive": ["crust", "mantle", "surface0", "surface1", "outline"]
    },
    "tokens": {
      "border": "outline",
      "box_label": "accent",
      "prompt": "accent",
      "query": "text",
      "info": "dim",
      "table_head": "dim",
      "selection_bg": "highlight",
      "selection_edge": "accent",
      "target_bg": "mantle",
      "target_fg": "accent",
      "chip_bg": "accent",
      "chip_fg": "crust",
      "chip_bad_bg": "danger",
      "chip_bad_fg": "crust",
      "hint_key": "accent2",
      "hint": "dim",
      "hint_active": "accent",
      "ok": "success",
      "error": "danger",
      "ws": "accent2",
      "tab_number": "accent",
      "tab_text": "info",
      "agent": "warning",
      "dir": "info",
      "cfg": "warning",
      "tree": "dim",
      "pane_id": "dim",
      "status_working": "warning",
      "status_blocked": "danger",
      "status_done": "success",
      "status_idle": "success",
      "status_unknown": "dim",
      "flash_from": "success",
      "flash_to": "base",
      "landing": "dim",
      "error_text": "danger",
      "ok_text": "success",
      "warn_text": "warning",
      "group": "dim",
      "link_title": "text",
      "link_meta": "dim",
      "link_icon": "info"
    },
    "selection_edge_glyph": "▌",
    "ws_bold": true,
    "pulse_from": "accent",
    "pulse_to": "base",
    "pulse_steps": 4
  },

  "help": "{b}What's in the list{r}\n\n  {y}●{r} {B}name{r}        {b}open{r}    a herdr workspace that is running now\n     ├ {m}2{r} {o}claude{r}           its tabs, with the agent running in each\n     │   ├ {d}⠿{r} ○ {o}claude{r}     and each tab's splits (enter focuses the tab)\n  {d}\ue615{r} {y}name{r}  {d}saved{r}           a session from sesh/sesh.toml: opens a\n                          workspace at its path + runs its startup command\n  {c}\uf114{r} path  {d}recent{r}          a directory you use a lot (zoxide):\n                          opens a new workspace there\n\n{b}Directories{r}\n  ^a lists every existing zoxide directory (frecent ones, score >= {min_score} or a\n  git repo, first; top {max_dirs}). ^x lists them with scores. ^d on a\n  directory forgets it in zoxide for good (also for z / cd).\n\n{b}Moving splits{r}\n  drag a {d}⠿{r} split row, or a whole tab row, with the mouse onto a workspace (→ new tab\n  there) or a tab / another split (→ split into that tab). It moves\n  as soon as you let go (a tab's splits move together and land side by\n  side; moving a tab does not undo). Keys instead: select the row,\n  ^g, ↑/↓ to a workspace or tab, enter.\n\n{b}Agent status{r}\n  {y}●{r} working   {g}○{r} idle   {g}✓{r} done   {red}▲{r} needs input\n\n{b}Keys{r}\n  enter     switch to it (workspace / tab / agent), or create it\n  ^s        spaces     only the open herdr workspaces (the start view)\n  ^a        all        open workspaces + saved sessions + frecent dirs\n  ^m        expand     show every workspace's tabs + splits (drag to move);\n                       again to collapse back to one line per workspace\n                       (^e does the same where the terminal can't tell ^m from enter)\n  ^z        undo       put the last moved split back\n  ^g        move       move the selected split with the keys (↑/↓, enter)\n  ^t        agents     only agents, the ones that need you first\n  ^x        dirs       every zoxide directory, with its score\n  ^r        sort       open workspaces: recent → name → status\n  ^o        new        scratch workspace (a name → /tmp/name, or a path)\n  ^b        web        ask for a URL, open it in a browser workspace\n  ^d        close      close workspace / tab, forget a directory\n  ^k        ks         jump to kitchen-sink (the ▸ row on top; the cursor starts there):\n                       enter switches to it, → / ← list / hide its places\n  tab ^n    down       shift-tab ^p   up\n  esc       quit       ? this help (move the cursor to go back)\n"
}
