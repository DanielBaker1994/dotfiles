#!/bin/bash
# SSH_ASKPASS helper for macOS: shows native dialogs so ssh can ask for a
# key passphrase / FIDO PIN / touch even when run without a terminal
# (e.g. from Claude Code). Nothing is stored; the answer goes to ssh on stdout.
# Use: SSH_ASKPASS=~/.ssh/askpass-macos SSH_ASKPASS_REQUIRE=force ssh ...
prompt=${1:-"SSH passphrase:"}
esc=${prompt//\\/\\\\}; esc=${esc//\"/\\\"}

case "${SSH_ASKPASS_PROMPT:-}" in
  none)
    # Touch notification. ssh kills this process once the key is tapped.
    exec /usr/bin/osascript -e "display dialog \"$esc\" & return & return & \"Tap your YubiKey now.\" with title \"YubiKey\" buttons {\"Waiting...\"} giving up after 60 with icon caution" >/dev/null 2>&1
    ;;
  confirm)
    /usr/bin/osascript -e "display dialog \"$esc\" with title \"SSH\" buttons {\"No\",\"Yes\"} default button \"Yes\"" >/dev/null 2>&1 || exit 1
    echo yes
    ;;
  *)
    /usr/bin/osascript \
      -e "text returned of (display dialog \"$esc\" with title \"SSH - YubiKey\" default answer \"\" with hidden answer buttons {\"Cancel\",\"OK\"} default button \"OK\" with icon caution)" 2>/dev/null
    ;;
esac
