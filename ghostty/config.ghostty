keybind = global:alt+space=toggle_quick_terminal
keybind = global:ctrl+`=toggle_quick_terminal
macos-titlebar-style = hidden
# Inset the grid from the window edges so the tmux top bar clears the rounded corners.
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
scrollback-limit = 50000000

# Selecting text (Shift+drag inside tmux, which bypasses tmux's own copy
# mode) copies straight to the macOS clipboard — no Cmd+C needed.
copy-on-select = clipboard
# Scroll feel: trackpad 1 line per step, mouse wheel 5 lines per notch
# (default 3). tmux scrolls 1 line per event (see ~/.tmux.conf).
mouse-scroll-multiplier = precision:1,discrete:5

# Matches the Tokyo Night (night) theme used in nvim (see `theme` below).
macos-option-as-alt = true

# mouse-hide-while-typing = true
confirm-close-surface = true

# Ensure ctrl+s is never consumed by ghostty and always reaches the shell/tmux.
keybind = ctrl+s=unbind

# Disable Cmd+N (new window) so it doesn't spawn a separate Ghostty window.
keybind = cmd+n=unbind

# Disable Cmd+Enter (default: toggle_fullscreen), which is easy to hit by accident.
keybind = cmd+enter=unbind

# Disable Ctrl+Cmd+F (the other default toggle_fullscreen shortcut).
keybind = ctrl+cmd+f=unbind

# Disable Close All Windows (cmd+alt+shift+w), easy to hit by accident.
keybind = cmd+alt+shift+w=unbind


keybind = cmd+w=unbind
keybind = cmd+opt+w=unbind
keybind = super+shift+w=unbind
keybind = super+alt+i=unbind



keybind = cmd+shift+j=write_scrollback_file:paste,plain
font-family = "Hack Nerd Font"

# custom-shader = ~/.dotfiles/ghostty/shaders/soft_trail_shader.glsl

# Interpret terminal colors in Display P3 so the same hex values render
# richer/more saturated on the wide-gamut (Liquid Retina) panel.
window-colorspace = display-p3

# Colors: built-in TokyoNight Night theme (identical palette/bg/fg to the old
# hand-written block). Only the brighter selection colour is kept as an override.
theme = TokyoNight Night
selection-background = #33467c
selection-foreground = #c0caf5

# Command palette: types `close_spaces` + Enter into the focused shell (herdr workspaces)
command-palette-entry = title:"Close Spaces",description:"Close the herdr workspaces listed in CLOSE_SPACES_DEFAULT.",action:"text:close_spaces\n"
command-palette-entry = title:"Refresh AeroSpace",description:"Kill and reopen AeroSpace so all windows fall back into place.",action:"text:refresh_aerospace\n"

# ---- shell integration / agents ----
# Ping (macOS notification) when a command finishes after 30s while Ghostty is
# not focused. Needs shell integration (sourced in bash/.bash_profile).
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 30s

# cmd+up/down jump between shell prompts; cmd+shift+o opens the visible screen
# in $EDITOR (cmd+shift+j above pastes the scrollback path instead).
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
keybind = cmd+shift+o=write_screen_file:open

# ---- polish ----
unfocused-split-opacity = 0.85
window-save-state = always
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.1

# ---- background: Mt Fuji through Japanese maple (photo) ----
# "Lake Kawaguchiko and Mount Fuji at sunset during the Momijigari period",
# Wikimedia Commons, CC BY 2.0. Drawn in every pane; unfocused panes are dimmed
# by unfocused-split-opacity above, so the active one reads strongest.
# Tune background-image-opacity (0.1 subtle .. 0.3 obvious).
background-image = ~/.dotfiles/ghostty/images/fuji-photo.jpg
background-image-opacity = 0.05
background-image-position = center
background-image-fit = cover
