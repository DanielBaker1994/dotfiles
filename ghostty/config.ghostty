keybind = global:alt+space=toggle_quick_terminal
keybind = global:ctrl+`=toggle_quick_terminal
macos-titlebar-style = hidden
# Inset the grid from the window edges so the tmux top bar clears the rounded corners.
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
scrollback-limit = 50000000

# Selecting text (Shift+drag inside tmux, which bypasses tmux's own copy
# mode) copies straight to the macOS clipboard — no Cmd+C needed.
copy-on-select = clipboard
# Scroll feel: trackpad 1 line per step, mouse wheel 5 lines per notch
# (default 3). tmux scrolls 1 line per event (see ~/.tmux.conf).
mouse-scroll-multiplier = precision:1,discrete:5

# Matches the Tokyo Night (night) theme used in nvim (colors explicit below;
# Ghostty has no built-in Tokyo Night theme).
macos-option-as-alt = true

# mouse-hide-while-typing = true
confirm-close-surface = true

# Ensure ctrl+s is never consumed by ghostty and always reaches the shell/tmux.
keybind = ctrl+s=unbind
font-family = "JetBrainsMono Nerd Font"

# custom-shader = ~/.dotfiles/ghostty/shaders/soft_trail_shader.glsl

# Colors (Tokyo Night night)
background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #1a1b26
selection-background = #33467c
selection-foreground = #c0caf5
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5